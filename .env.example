# Contoh konfigurasi mcp-s3. Semua nilai di bawah adalah placeholder, bukan rahasia asli.
#
# Server TIDAK membaca file .env secara otomatis. Isi env lewat konfigurasi MCP client
# (.mcp.json, claude_desktop_config.json), lewat --env-file Docker, atau untuk uji manual:
#   cp .env.example .env    # .env sudah ada di .gitignore, jangan di-commit
#   node --env-file=.env dist/index.js
#
# Variabel S3_* dan MCP_S3_* yang opsional dan dikosongkan dianggap tidak di-set (memakai
# default). Variabel AWS_* lebih aman di-comment daripada dikosongkan.
# Nilai boolean: true/false (juga diterima 1/0, yes/no, on/off), tidak case-sensitive.
#
# Isi file:
#   1. Umum (stdio dan http)
#   2. Khusus mode stdio
#   3. Khusus mode http (remote, OAuth)

# =============================================================================
# 1. UMUM (stdio dan http)
# =============================================================================

# --- Wajib -------------------------------------------------------------------

# Nama bucket. Tidak ditampilkan ke Claude dan tidak ditulis ke log server.
S3_BUCKET=my-bucket
# Root prefix: satu-satunya area yang bisa diakses. Wajib diakhiri "/", tidak boleh
# kosong, tidak boleh diawali "/", dan tidak boleh berisi segmen "." / ".." atau "//".
S3_ROOT_PREFIX=claude-workspace/
# Region bucket.
AWS_REGION=ap-southeast-1

# --- Credential AWS ----------------------------------------------------------
# Tidak dibaca oleh kode server, melainkan oleh default credential provider chain
# AWS SDK v3. Pakai IAM user/role khusus dengan iam-policy.example.json.
# Mode http: pakai IAM user/role TERPISAH dari mode stdio (lihat README, "Setup IAM").

# Disarankan untuk stdio: profile di ~/.aws/credentials (lihat README, "Setup IAM").
AWS_PROFILE=mcp-s3
# Alternatif dari profile (umum di container). JANGAN menaruh access key asli di file
# yang di-commit.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Hanya untuk credential sementara (STS).
# AWS_SESSION_TOKEN=

# --- S3-compatible (MinIO, Cloudflare R2, Wasabi, ...) -----------------------
# Kosongkan untuk AWS S3.

# Endpoint http(s), contoh MinIO lokal.
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# Default false. Biasanya true untuk MinIO.
# S3_FORCE_PATH_STYLE=false

# --- Batas -------------------------------------------------------------------

# Maksimum byte per panggilan read_object. Default 1048576 (1 MiB).
# MCP_S3_MAX_READ_BYTES=1048576
# Maksimum entri per halaman list_objects dan hasil search_objects.
# Default 200, maksimum 1000 (batas S3).
# MCP_S3_MAX_LIST_KEYS=200
# Batas byte per tulis. Default 5242880 (5 MiB). Belum dipakai: versi ini read-only.
# MCP_S3_MAX_WRITE_BYTES=5242880

# --- Transport dan log -------------------------------------------------------

# stdio (default) atau http. Lihat bagian 2 dan 3.
# MCP_S3_TRANSPORT=stdio
# DEBUG, INFO, WARN, atau ERROR. Default INFO. Log selalu ke stderr.
# Audit log (satu baris JSON per pemanggilan tool) selalu aktif, tidak dipengaruhi level ini.
# MCP_S3_LOG_LEVEL=INFO

# SECRET (berisi password). Jika diisi, audit log juga disimpan ke PostgreSQL (tabel
# mcp_s3_audit_log). Audit log tetap ditulis ke stderr. Tabel dibuat oleh migrasi Prisma, bukan
# oleh server: jalankan SEKALI  npm run db:migrate  (variabel ini dibaca juga oleh Prisma CLI).
# Untuk database lewat jaringan, tambahkan ?sslmode=verify-full.
# MCP_S3_AUDIT_DATABASE_URL=postgresql://mcp_s3:<password>@127.0.0.1:5432/mcp_s3

# SECRET. Kunci AES-256-GCM (32 byte, base64). Mengenkripsi next_token dari list_objects,
# dan di mode http juga menjadi sumber kunci OAuth (client terdaftar, code, token).
# Wajib jika MCP_S3_TRANSPORT=http. Opsional di stdio: tanpa kunci ini, server memakai
# kunci acak per proses, jadi next_token tidak berlaku lagi setelah restart.
# Buat SEKALI lalu simpan (jangan dibuat ulang setiap start):  openssl rand -base64 32
# Mengganti kunci ini membatalkan semua next_token, client OAuth terdaftar, dan token OAuth.
# Jangan di-commit, jangan di-log, jangan dipakai ulang dari contoh mana pun.
# MCP_S3_TOKEN_KEY=

# =============================================================================
# 2. KHUSUS MODE STDIO (Claude Code / Claude Desktop di komputer yang sama)
# =============================================================================

# Default true. Versi ini belum punya tool write; nilai false hanya memunculkan WARN.
# Di mode http, nilai false membuat server gagal start.
# MCP_S3_READ_ONLY=true
# Default false. Belum ada tool delete; tidak berefek selama read-only.
# Di mode http, nilai true membuat server gagal start.
# MCP_S3_ALLOW_DELETE=false

# =============================================================================
# 3. KHUSUS MODE HTTP (MCP_S3_TRANSPORT=http): Streamable HTTP + OAuth
# =============================================================================
# Mode http selalu read-only dan wajib MCP_S3_TOKEN_KEY (bagian 1). Variabel di bawah
# tidak dibaca di mode stdio.

# --- Jaringan ----------------------------------------------------------------

# Alamat bind. Default 127.0.0.1 (hanya lokal). Di container: 0.0.0.0.
# Bind bukan loopback dengan MCP_S3_PUBLIC_URL http memicu WARN (tanpa TLS). Di container,
# publish port hanya ke 127.0.0.1 (docker run -p 127.0.0.1:3000:3000).
# MCP_S3_HTTP_HOST=127.0.0.1
# Port. Default 3000.
# MCP_S3_HTTP_PORT=3000
# Origin publik server, sekaligus OAuth issuer. Wajib jika MCP_S3_HTTP_HOST bukan alamat
# loopback. Wajib https, kecuali localhost/127.0.0.1. Tanpa path, query, atau fragment:
# server harus berada di root hostname-nya sendiri. Default http://localhost:<port>.
# Client harus memakai host yang sama persis (localhost dan 127.0.0.1 dianggap berbeda).
# MCP_S3_PUBLIC_URL=https://mcp.example.com
# Jumlah hop reverse proxy yang dipercaya untuk X-Forwarded-For (0-10). Default 0.
# Isi 1 jika tepat satu proxy (mis. Caddy di deploy/) ada di depan server. Tanpa ini,
# semua client terlihat dengan IP proxy dan rate limit login serta client secret per IP
# menjadi global.
# MCP_S3_TRUST_PROXY=0

# --- Akun admin (halaman login OAuth) ------------------------------------------

# SECRET. Satu akun statis yang dipakai bersama semua user. Wajib di mode http; tidak ada
# nilai default. Password minimal 12 karakter. Buat password acak, misalnya:
#   openssl rand -base64 18
# Mengganti username atau password membuat semua client harus login ulang. Ini juga cara
# mencabut refresh token yang bocor: token yang dirotasi atau dicabut bisa berlaku lagi
# setelah restart, paling lama 7 hari (umur refresh token, sliding, maks 90 hari sejak login).
# MCP_S3_AUTH_USERNAME=
# MCP_S3_AUTH_PASSWORD=

# --- Client OAuth ------------------------------------------------------------

# Dynamic client registration (POST /register): dipakai "Register automatically" di
# claude.ai, Claude Code, dan MCP Inspector. Default true. Jika false, wajib mengisi
# client statis di bawah.
# MCP_S3_OAUTH_DYNAMIC_REGISTRATION=true

# Client statis untuk opsi "Use your own OAuth client" di claude.ai. Isi keduanya atau
# kosongkan keduanya. Client ID: 1-128 karakter A-Z a-z 0-9 . _ ~ -
# SECRET. Client secret minimal 32 karakter, hanya A-Z a-z 0-9 . _ ~ -, misalnya:
#   openssl rand -hex 32
# MCP_S3_OAUTH_CLIENT_ID=
# MCP_S3_OAUTH_CLIENT_SECRET=

# Redirect URI yang diterima (dipisah koma, dicocokkan persis). Berlaku untuk client
# terdaftar (DCR) dan client statis. Mengisi variabel ini MENGGANTI default, tidak
# menambah. Wajib https, kecuali localhost/127.0.0.1/[::1]. Untuk DCR, redirect URI
# loopback (http://localhost:<port>/..., http://127.0.0.1:<port>/...) selalu diterima.
# Client statis hanya menerima loopback yang tercantum di sini (port bebas, host dan path
# harus sama; localhost dan 127.0.0.1 dianggap berbeda).
# Default: https://claude.ai/api/mcp/auth_callback (callback claude.ai).
# Contoh menambah callback lain (tulis ulang default karena nilai ini menggantinya):
# MCP_S3_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://app.example.com/oauth/callback
