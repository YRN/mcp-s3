{
  "name": "mcp-s3",
  "version": "0.1.0",
  "description": "MCP server that gives Claude jailed access to a single S3 root prefix",
  "type": "module",
  "bin": {
    "mcp-s3": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "eslint . && tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run test/unit",
    "test:int": "docker compose up -d --wait && vitest run test/integration",
    "test:e2e": "npm run build && docker compose up -d --wait && vitest run test/e2e",
    "test:all": "npm test && npm run test:int && npm run test:e2e",
    "minio:down": "docker compose down -v",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "s3",
    "claude"
  ],
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.3",
    "@types/picomatch": "^4.0.3",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.15.0",
    "picomatch": "4.0.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
