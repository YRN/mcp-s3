# Environment for deploy/compose.yml. Copy to deploy/mcp-s3.env (git-ignored) and fill in.
# Transport, bind address, port, public URL, and proxy trust are set in compose.yml.
# The HTTP mode is always read-only: do not set MCP_S3_READ_ONLY=false or MCP_S3_ALLOW_DELETE=true.

# --- S3 ---------------------------------------------------------------------------
S3_BUCKET=my-bucket
S3_ROOT_PREFIX=claude-workspace/
AWS_REGION=ap-southeast-1
# Use a separate IAM user/role with the read-only policy (s3:ListBucket on the root prefix,
# s3:GetObject under it). On EC2/ECS prefer an instance/task role and leave these empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false

# --- secrets ------------------------------------------------------------------------
# 32 random bytes, base64: openssl rand -base64 32
# Encrypts list continuation tokens and (through derived keys) OAuth clients, codes, and tokens.
# Changing it invalidates every registered client and issued token.
MCP_S3_TOKEN_KEY=

# The single admin login shown on the OAuth sign-in page (shared by all users).
# Password: at least 12 characters, e.g. openssl rand -base64 18
# Changing the username or password signs out every client (all tokens become invalid).
# Do this if a refresh token may have leaked: a rotated or revoked refresh token is accepted
# again after a restart, for up to 7 days.
MCP_S3_AUTH_USERNAME=admin
MCP_S3_AUTH_PASSWORD=

# --- OAuth clients (optional) ---------------------------------------------------------
# Pre-registered client for claude.ai "Use your own OAuth client". Enter both Client ID and
# Secret in claude.ai: with an empty secret Claude acts as a public client, which fails here.
# Secret: at least 32 characters, only A-Z a-z 0-9 . _ ~ -  (e.g. openssl rand -hex 32)
# MCP_S3_OAUTH_CLIENT_ID=claude-ai
# MCP_S3_OAUTH_CLIENT_SECRET=

# Dynamic client registration ("Register automatically" in claude.ai, Claude Code, MCP Inspector).
# MCP_S3_OAUTH_DYNAMIC_REGISTRATION=true

# Exact redirect URIs (comma-separated). Setting this replaces the default.
# Default: https://claude.ai/api/mcp/auth_callback
# Dynamically registered clients may also use loopback redirects; the static client only
# gets loopback redirects listed here (localhost and 127.0.0.1 are not interchangeable).
# MCP_S3_OAUTH_REDIRECT_URIS=

# --- audit log database (optional) ----------------------------------------------------
# Audit lines always go to stderr (docker logs); with this URL they are also saved to
# PostgreSQL. SECRET: it contains the password. For the postgres service in compose.yml
# (--profile audit-db) use the same password as MCP_S3_AUDIT_DB_PASSWORD, made of characters
# that need no URL encoding (openssl rand -hex 24). For an external database add
# ?sslmode=verify-full. The table is NOT created by the server: run the one-off migrate service
# once (see compose.yml); it reads this same variable.
# MCP_S3_AUDIT_DATABASE_URL=postgresql://mcp_s3:<password>@postgres:5432/mcp_s3

# MCP_S3_LOG_LEVEL=INFO
