{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyUnderRoot",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::my-bucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["claude-workspace/", "claude-workspace/*"]
        }
      }
    },
    {
      "Sid": "ReadUnderRoot",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::my-bucket/claude-workspace/*"
    }
  ]
}
